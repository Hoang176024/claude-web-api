# Optional: Session key from claude.ai cookies (can also be passed from Noveral UI)
CLAUDE_SESSION_KEY=sk-ant-sid01-your-session-key-here

# Optional: SQLite Database path for settings
SQLITE_DB_PATH=/app/data/sqlite.db

# Optional: HTTP/HTTPS proxy if needed (e.g., http://127.0.0.1:7890)
# CLAUDE_PROXY=

# Service Port (Default: 3002 to avoid collision with Gemini on 3000 and Noveral on 3001)
PORT=3002
CLAUDE_TIMEOUT=60
CLAUDE_AUTO_CLOSE=true
CLAUDE_CLOSE_DELAY=300
